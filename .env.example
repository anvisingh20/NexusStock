# NexusStock - System Environment Variables

# --- Database Configurations ---
# Fallback to local SQLite if left blank, e.g. "sqlite:///./inventory.db"
# Use this connection format for PostgreSQL:
DATABASE_URL=postgresql://admin:supersecurepwd@localhost:5432/nexusstock

# --- API Server Settings ---
PORT=8000
HOST=0.0.0.0

# --- Frontend Client Settings ---
# Injects the backend server's URL into the compiled React build
VITE_API_URL=http://localhost:8000
